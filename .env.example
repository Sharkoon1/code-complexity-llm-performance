# Run LM-CC locally (true) or via a remote endpoint (false). Default: true.
LOCAL_LM_CC=true

# Required when LOCAL_LM_CC=false
LM_CC_REMOTE_URL=https://api.runpod.ai/v2/<endpoint-id>/runsync
LM_CC_REMOTE_KEY=<runpod-api-key>

# DEEPSEEK Api key to run human eval
DEEPSEEK_API_KEY =<deepseek-api-key>

# Local override (optional)
# LM_CC_MODEL=Qwen/Qwen2.5-Coder-0.5B
# LM_CC_DEVICE=mps

# Only needed when building a Docker image for a GATED model (e.g. CodeLlama).
# HF_TOKEN=hf_xxx
